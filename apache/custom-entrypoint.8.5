#!/bin/sh
# - Se il comando e' Apache: rigenera la configurazione prefork e, se richiesto, rimappa www-data su PUID/PGID.
# - Per qualsiasi altro comando (php, sh, cron...) esegue direttamente: funziona anche con "user: 1000:1000".
set -eu

# first arg is `-f` or `--some-option`
if [ "${1#-}" != "$1" ]; then
    set -- apache2-foreground "$@"
fi

case "${1:-}" in
    apache2-foreground|apache2|apache2ctl|httpd)
        # Rimappa www-data su PUID/PGID (es. 1000): Apache scala i privilegi su un utente che esiste in /etc/passwd,
        # senza AH02155 e senza worker root. Richiede root e filesystem scrivibile.
        if [ -n "${PUID:-}${PGID:-}" ]; then
            [ "$(id -u)" = 0 ] || { echo "ERRORE: PUID/PGID richiedono di avviare come root" >&2; exit 1; }
            for v in PUID PGID; do
                eval "val=\${$v:-}"
                case "$val" in *[!0-9]*) echo "ERRORE: $v deve essere numerico" >&2; exit 1 ;; esac
            done
            if [ -n "${PGID:-}" ]; then
                if getent group "$PGID" | grep -qv '^www-data:'; then
                    echo "ERRORE: il GID $PGID e' gia' usato da un altro gruppo" >&2; exit 1
                fi
                sed -i -E "s/^(www-data:[^:]*:)[0-9]+:/\1${PGID}:/" /etc/group
                sed -i -E "s/^(www-data:[^:]*:[0-9]+:)[0-9]+:/\1${PGID}:/" /etc/passwd
            fi
            if [ -n "${PUID:-}" ]; then
                if getent passwd "$PUID" | grep -qv '^www-data:'; then
                    echo "ERRORE: l'UID $PUID e' gia' usato da un altro utente" >&2; exit 1
                fi
                sed -i -E "s/^(www-data:[^:]*:)[0-9]+:/\1${PUID}:/" /etc/passwd
            fi
            echo "www-data -> uid=$(id -u www-data) gid=$(id -g www-data)"
        fi
        apache-render-mpm
        ;;
esac

exec "$@"
